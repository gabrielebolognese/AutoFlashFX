      "effort": "medium"
    },
    "reviewer": {
      "model": "sonnet",
      "effort": "high"
    },
    "cut": {
      "model": "sonnet",
      "effort": "medium"
    },
    "checks": {
      "model": "sonnet",
      "effort": "medium"
    },
    "fixer": {
      "model": "sonnet",
      "effort": "medium"
    },
    "builder_escalation": {
      "model": "opus",
      "effort": "xhigh",
      "important": {
        "model": "fable",
        "effort": "xhigh"
      }
    },
    "reviewer_escalation": {
      "model": "opus",
      "effort": "xhigh",
      "important": {
        "model": "fable",
        "effort": "xhigh"
      }
    },
    "indexer": {
      "model": "haiku",
      "effort": "low"
    },
    "probe": {
      "model": "haiku",
      "effort": "low"
    },
    "visual_director_escalation": {
      "model": "opus",
      "effort": "xhigh",
      "important": {
        "model": "fable",
        "effort": "xhigh"
      }
    },
    "limit_fallback": {
      "model": "opus"
    }
  },
  "tts": {
    "device": "cpu",
    "whisper_model": "small",
    "whisper_python": "C:/Users/there/venvs/chatterbox/Scripts/python.exe",
    "whisper_pad_s": 0.5,
    "wer_fail_pct": 3,
    "wer_flag_max_pct": 8,
    "overrun_pct": 15,
    "overrun_min_s": 0.4,
    "lead_s": 0.05,
    "tail_s": 0.2
  },
  "caps": {
    "angle_rounds": 2,
    "script_rounds": 3,
    "review_rounds_opus": 3,
    "review_rounds_fable": 2,
    "error_review_cycles": 3,
    "escalation_cycles": 1,
    "systemic_block_streak": 3
  },
  "errors": {
    "transient_backoff_seconds": [
      60,
      240,
      960
    ],
    "unparsed_limit_sleep_seconds": 1800,
    "probe_every_seconds": 1800,
    "repeated_signature_skip": 2,
    "log_tail_lines": 200,
    "classify_tail_lines": 40,
    "script_limit_retries": 2
  },
  "timeouts": {
    "model_call_seconds": 3600,
    "research_seconds": 2700,
    "angle_seconds": 2700,
    "expansion_seconds": 900,
    "gate_seconds": 900,
    "screenshot_seconds": 60,
    "index_seconds": 600,
    "hooks_seconds": 1200,
    "brief_seconds": 1200,
    "judge_seconds": 900,
    "script_seconds": 1800,
    "cut_seconds": 900,
    "checks_seconds": 900,
    "pick_seconds": 900,
    "transcribe_seconds": 1800,
    "tts_seconds": 1800,
    "align_seconds": 1800,
    "loudness_seconds": 300,
    "profile_seconds": 1200,
    "plan_seconds": 1800,
    "build_seconds": 2400,
    "check_seconds": 900,
    "events_seconds": 900,
    "render_draft_seconds": 3600,
    "reviewer_seconds": 2400,
    "fixer_seconds": 2400,
    "verify_seconds": 900,
    "probe_seconds": 300,
    "sfx_seconds": 1200,
    "mechanical_seconds": 1800,
    "style_seconds": 1200,
    "edit_review_seconds": 1800,
    "render_final_seconds": 5400,
    "render_hook2_seconds": 1200,
    "mux_seconds": 900,
    "caption_seconds": 900
  },
  "review": {
    "reviewer_tools": "Read Glob Grep WebSearch WebFetch",
    "fixer_tools": "Read Glob Grep Edit Write Bash",
    "fixer_paths": [
      "pipeline",
      "channels/{channel}/motion-lib/candidates"
    ],
    "protected_paths": [
      "channels/*/ideas.txt",
      "channels/*/library",
      "channels/*/styles",
      "exports"
    ]
  },
  "runner": {
    "poll_seconds": 120,
    "status_every_seconds": 300,
    "limit_margin_seconds": 120,
    "timezone": "Europe/Rome",
    "sleep_scale": 1,
    "lock_stale_seconds": 60,
    "lock_wait_seconds": 30,
    "min_free_gb": 10
  },
  "heavy": {
    "stale_seconds": 21600,
    "poll_seconds": 2,
    "wait_log_seconds": 600,
    "kinds": ["tts", "transcribe", "render", "encode", "analyze", "frame-match", "capture"]
  },
  "paths": {
    "exports": "exports",
    "vendor": "pipeline/vendor/ig-agent-skill",
    "known_issues": "pipeline/knowledge/known-issues.md",
    "venv_python": ".venv-tts/Scripts/python.exe",
    "kokoro_python": "C:/Users/there/venvs/kokoro/Scripts/python.exe"
  },
  "preflight": {
    "require": [
      {
        "check": "command",
        "name": "claude",
        "fix": "npm install -g @anthropic-ai/claude-code, then run claude once and log in"
      },
      {
        "check": "command",
        "name": "ffmpeg",
        "fix": "winget install Gyan.FFmpeg, then open a new terminal"
      },
      {
        "check": "command",
        "name": "ffprobe",
        "fix": "ffprobe ships with ffmpeg: winget install Gyan.FFmpeg, then open a new terminal"
      },
      {
        "check": "command",
        "name": "python",
        "min_version": "3.11",
        "fix": "install Python 3.13 from python.org with 'Add to PATH'; 'python' must resolve to it (python3 is the Windows Store stub)"
      },
      {
        "check": "command",
        "name": "node",
        "min_version": "22.0",
        "fix": "install Node 22 LTS from nodejs.org"
      },
      {
        "check": "command",
        "name": "gh",
        "fix": "winget install GitHub.cli, then gh auth login"
      },
      {
        "check": "command",
        "name": "git",
        "fix": "install Git for Windows from git-scm.com"
      },
      {
        "check": "python_module",
        "name": "jsonschema",
        "fix": "bash pipeline/bin/setup-python"
      },
      {
        "check": "python_module",
        "name": "playwright",
        "level": "warn",
        "fix": "bash pipeline/bin/setup-python (installs playwright and its Chromium; without it the research stage takes no screenshots)"
      },
      {
        "check": "file",
        "path": "node_modules/hyperframes/package.json",
        "fix": "bash pipeline/bin/setup-node (installs the pinned hyperframes, gsap and three packages and the render browser)"
      },
      {
        "check": "disk",
        "min_free_gb": 10,
        "fix": "free at least 10 GB on the drive that holds the repo (renders live in runs/ and exports/)"
      },
      {
        "check": "shell",
        "cmd": "gh auth status",
        "level": "warn",
        "fix": "gh auth login (the research stage needs it from M4 on)"
      }
    ]
  },
  "render": {
    "draft_resolution": "540x960",
    "final_resolution": "1080x1920",
    "fps": 30,
    "quality": "looks",
    "audio_bitrate_k": 160,
    "audio_channels": 1,
    "duration_tolerance_s": 0.2,
    "loudness_tolerance_lu": 1.0,
    "true_peak_tolerance_db": 0.5,
    "hook2_max_s": 3.5
  },
  "logs": {
    "rotate_mb": 50,
    "rotate_keep": 3
  }
}
