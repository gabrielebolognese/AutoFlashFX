{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://instagramreels.local/stages/09c-transitions/model.json",
  "title": "The visual director's answer for the transitions pass (S9c): how each scene leaves",
  "type": "object",
  "required": ["transitions"],
  "properties": {
    "transitions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["from", "to", "type"],
        "properties": {
          "from": {"type": "string", "description": "the leaving scene id"},
          "to": {"type": "string", "description": "the next scene id"},
          "type": {"type": "string", "enum": ["fade-blur", "fall", "push", "cut"]},
          "why": {"type": "string"}
        }
      }
    },
    "notes": {"type": "string"}
  }
}
