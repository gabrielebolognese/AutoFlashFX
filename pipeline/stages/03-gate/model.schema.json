{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://instagramreels.local/stages/03-gate/model-output",
  "title": "03-gate: the gate model's structured answer (BUILD_SPEC.md S3); gate.py decide applies the rules and writes gate.json",
  "type": "object",
  "required": ["scores", "F", "evidence", "reason", "angle_hint", "different_topic", "suggested_idea"],
  "properties": {
    "scores": {
      "type": "object",
      "required": ["P", "S", "C"],
      "properties": {
        "P": {"type": "integer", "minimum": 0, "maximum": 3},
        "S": {"type": "integer", "minimum": 0, "maximum": 3},
        "C": {"type": "integer", "minimum": 0, "maximum": 3}
      }
    },
    "F": {"type": "string", "enum": ["ok", "fail"]},
    "evidence": {
      "type": "object",
      "required": ["P", "S", "C", "F"],
      "properties": {
        "P": {"type": "string"},
        "S": {"type": "string"},
        "C": {"type": "string"},
        "F": {"type": "string"}
      }
    },
    "reason": {"type": "string"},
    "angle_hint": {"type": "string"},
    "different_topic": {"type": "boolean"},
    "suggested_idea": {"type": "string"}
  }
}
