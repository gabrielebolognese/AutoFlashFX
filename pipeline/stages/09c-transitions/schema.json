{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://instagramreels.local/stages/09c-transitions/plan.json",
  "title": "09c-transitions plan.json: the transitions pass of the visual plan (BUILD_SPEC.md S9 9c; generated by pass-schemas.py); merged.json beside it is the whole plan",
  "type": "object",
  "required": [
    "pass",
    "transitions"
  ],
  "properties": {
    "pass": {
      "const": "transitions"
    },
    "transitions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "from",
          "to",
          "type",
          "duration_ms"
        ],
        "properties": {
          "from": {
            "type": "string"
          },
          "to": {
            "type": "string"
          },
          "type": {
            "enum": [
              "fade-blur",
              "fall",
              "push",
              "cut"
            ]
          },
          "duration_ms": {
            "type": "integer",
            "minimum": 0
          }
        }
      }
    },
    "notes": {
      "type": "string"
    }
  }
}
