{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://instagramreels.local/stages/09b-text/plan.json",
  "title": "09b-text plan.json: the text pass of the visual plan (BUILD_SPEC.md S9 9b; generated by pass-schemas.py)",
  "type": "object",
  "required": [
    "pass",
    "captions",
    "cards",
    "labels"
  ],
  "properties": {
    "pass": {
      "const": "text"
    },
    "captions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "start_ms",
          "end_ms",
          "words"
        ],
        "properties": {
          "scene": {
            "type": "string"
          },
          "start_ms": {
            "type": "integer"
          },
          "end_ms": {
            "type": "integer"
          },
          "words": {
            "type": "array",
            "minItems": 1,
            "maxItems": 4,
            "items": {
              "type": "object",
              "required": [
                "word",
                "start_ms",
                "end_ms"
              ],
              "properties": {
                "word": {
                  "type": "string"
                },
                "start_ms": {
                  "type": "integer"
                },
                "end_ms": {
                  "type": "integer"
                },
                "emphasis": {
                  "type": "boolean"
                }
              }
            }
          }
        }
      }
    },
    "overrides": {
      "type": "array",
      "description": "the card texts the pass changed: applied to the 9a instances' props by the merge",
      "items": {
        "type": "object",
        "required": [
          "component",
          "prop",
          "text"
        ],
        "properties": {
          "scene": {
            "type": "string"
          },
          "component": {
            "type": "string"
          },
          "prop": {
            "type": "string"
          },
          "text": {
            "type": "string"
          }
        }
      }
    },
    "cards": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "scene",
          "text"
        ],
        "properties": {
          "scene": {
            "type": "string"
          },
          "component": {
            "type": "string"
          },
          "text": {
            "type": "string"
          },
          "zone": {
            "type": "string"
          },
          "prop": {
            "type": "string",
            "description": "the prop of the component instance that carries this text"
          },
          "words": {
            "type": "integer"
          }
        }
      }
    },
    "labels": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "scene",
          "text",
          "kind"
        ],
        "properties": {
          "scene": {
            "type": "string"
          },
          "text": {
            "type": "string"
          },
          "kind": {
            "enum": [
              "honesty",
              "tag",
              "kicker"
            ]
          },
          "component": {
            "type": "string"
          }
        }
      }
    },
    "notes": {
      "type": "string"
    }
  }
}
