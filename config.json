      "effort": "medium"
    },
    "judge": {
      "model": "sonnet",
      "effort": "medium"
    },
    "script": {
      "model": "sonnet",
      "effort": "high"
    },
    "visual_director": {
      "model": "opus",
      "effort": "high"
    },
    "visual_director_fix": {
      "model": "sonnet",
      "effort": "high"
    },
    "builder": {
      "model": "sonnet",
      "effort": "high"
    },
    "qa": {
