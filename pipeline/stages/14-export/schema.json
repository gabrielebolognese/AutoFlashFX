{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://instagramreels.local/stages/14-export/export.json",
  "title": "14-export export.json (M12): the caption, the hashtags, the keyword and its deliverable, the solution, the hooks, the flags, the facts and the files the runner's export step copies",
  "type": "object",
  "required": [
    "caption",
    "hashtags",
    "keyword",
    "deliverable",
    "deliverable_status",
    "solution",
    "hooks",
    "files"
  ],
  "properties": {
    "caption": {
      "type": "string",
      "minLength": 1
    },
    "hashtags": {
      "type": "array",
      "maxItems": 5,
      "items": {
        "type": "string",
        "pattern": "^#[A-Za-z0-9_]+$"
      }
    },
    "solution": {
      "type": "object",
      "required": ["type"],
      "properties": {
        "type": {"type": "string", "enum": ["none", "flashfx", "external", "method"]},
        "name": {"type": "string"},
        "url": {"type": "string"}
      }
    },
    "lint": {"type": "object"},
    "humanize": {"type": "object"},
    "checks": {"type": "object"},
    "written_by": {"type": "string"},
    "checked": {"type": "string"},
    "keyword": {
      "type": "string"
    },
    "deliverable": {
      "type": "string"
    },
    "deliverable_status": {
      "type": "string",
      "enum": [
        "existing",
        "new"
      ]
    },
    "link": {
      "type": "string"
    },
    "hooks": {
      "type": "object",
      "required": [
        "hook1",
        "hook2"
      ],
      "properties": {
        "hook1": {
          "type": "string"
        },
        "hook2": {
          "type": "string"
        }
      }
    },
    "needs_review": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "facts": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "claim",
          "url",
          "checked"
        ],
        "properties": {
          "claim": {
            "type": "string"
          },
          "url": {
            "type": "string"
          },
          "checked": {
            "type": "string"
          }
        }
      }
    },
    "files": {
      "type": "object",
      "required": [
        "reel",
        "hook2"
      ],
      "properties": {
        "reel": {
          "type": "string"
        },
        "hook2": {
          "type": "string"
        }
      }
    }
  }
}
