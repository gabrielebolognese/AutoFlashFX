{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://instagramreels.local/stages/09b-text/plan.json",
  "title": "09b-text plan.json: the text pass of the visual plan (BUILD_SPEC.md S9 9b; generated by pass-schemas.py)",
  "type": "object",
  "required": [
    "pass",
    "captions",
    "cards",
    "labels"
  ],
  "properties": {
    "pass": {
      "const": "text"
    },
    "captions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "start_ms",
          "end_ms",
          "words"
        ],
        "properties": {
          "scene": {
            "type": "string"
          },
          "start_ms": {
            "type": "integer"
          },
          "end_ms": {
            "type": "integer"
          },
          "words": {
            "type": "array",
            "minItems": 1,
            "maxItems": 6,
            "items": {
              "type": "object",
              "required": [
                "word",
                "start_ms",
                "end_ms"
              ],
              "properties": {
                "word": {
                  "type": "string"
                },
                "start_ms": {
                  "type": "integer"
                },
                "end_ms": {
                  "type": "integer"
                },
                "emphasis": {
                  "type": "boolean"
                }
              }
            }
          },
          "mode": {
            "type": "string",
            "enum": [
              "word",
              "group"
            ],
            "description": "E3: word mode (one word at a time on its spoken time) or group mode (the group as the graphic); a chunk without a mode is word mode (plans before M15)"
          },
          "importance": {
            "type": "string",
            "enum": [
              "hook",
              "key-claim",
              "number",
              "payoff",
              "pre-ask",
              "normal"
            ],
            "description": "the beat's importance from script.json, which picks the mode"
          },
          "anchor": {
            "type": "integer",
            "minimum": 0,
            "description": "group mode: the index of the anchor word in words"
          },
          "layout": {
            "type": "object",
            "description": "group mode: kinetic.py's placement of every word (fonts, sizes, boxes in canvas px), recomputed by the engine, never written by a model"
          },
          "motion": {
            "type": "object",
            "description": "E3: how the entry moves while on screen: {kind: rise, px} or {kind: turn, deg} (a word's life in word mode, the whole block's in group mode)"
          }
        }
      }
    },
    "overrides": {
      "type": "array",
      "description": "the card texts the pass changed: applied to the 9a instances' props by the merge",
      "items": {
        "type": "object",
        "required": [
          "component",
          "prop",
          "text"
        ],
        "properties": {
          "scene": {
            "type": "string"
          },
          "component": {
            "type": "string"
          },
          "prop": {
            "type": "string"
          },
          "text": {
            "type": "string"
          }
        }
      }
    },
    "cards": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "scene",
          "text"
        ],
        "properties": {
          "scene": {
            "type": "string"
          },
          "component": {
            "type": "string"
          },
          "text": {
            "type": "string"
          },
          "zone": {
            "type": "string"
          },
          "prop": {
            "type": "string",
            "description": "the prop of the component instance that carries this text"
          },
          "words": {
            "type": "integer"
          }
        }
      }
    },
    "labels": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "scene",
          "text",
          "kind"
        ],
        "properties": {
          "scene": {
            "type": "string"
          },
          "text": {
            "type": "string"
          },
          "kind": {
            "enum": [
              "honesty",
              "tag",
              "kicker"
            ]
          },
          "component": {
            "type": "string"
          }
        }
      }
    },
    "notes": {
      "type": "string"
    }
  }
}
