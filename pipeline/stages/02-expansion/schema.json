{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://instagramreels.local/stages/02-expansion/expansion.json",
  "title": "02-expansion expansion.json (M4): the five parts of spec S2 as fields, written by pipeline/lib/expansion.py",
  "type": "object",
  "required": ["problem", "solution", "share_identity", "takeaway", "keyword", "deliverable", "deliverable_status", "one_true_thing", "evidence"],
  "properties": {
    "problem": {"type": "string", "minLength": 1},
    "solution": {"type": "string", "minLength": 1},
    "share_identity": {"type": "string", "minLength": 1},
    "takeaway": {"type": "string", "minLength": 1},
    "keyword": {"type": "string", "minLength": 1},
    "deliverable": {"type": "string", "minLength": 1},
    "deliverable_status": {"type": "string", "enum": ["existing", "new"]},
    "deliverable_link": {"type": "string"},
    "one_true_thing": {"type": "string", "minLength": 1},
    "evidence": {"type": "array", "items": {"type": "string"}},
    "evidence_refs": {"type": "array", "items": {"type": "integer"}},
    "chars": {"type": "integer"},
    "round": {"type": "integer"},
    "written_by": {"type": "string"},
    "checked": {"type": "string"},
    "rule_errors": {"type": "array", "items": {"type": "string"}}
  }
}
