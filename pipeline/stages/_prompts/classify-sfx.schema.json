{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://instagramreels.local/prompts/classify-sfx",
  "title": "classify-sfx: the indexer model's batched classification of unclear sound files (BUILD_SPEC.md 2.6)",
  "type": "object",
  "required": ["files"],
  "properties": {
    "files": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "cue_types", "tags", "confidence", "note"],
        "properties": {
          "id": {"type": "string"},
          "cue_types": {
            "type": "array",
            "maxItems": 3,
            "items": {"type": "string", "enum": ["transition_slow", "transition_fast", "attention", "hero_enter", "ui_click", "stamp", "number", "success", "typing", "negative", "hook_hit", "notification"]}
          },
          "tags": {"type": "array", "items": {"type": "string"}},
          "confidence": {"type": "number", "minimum": 0, "maximum": 1},
          "note": {"type": "string"}
        }
      }
    }
  }
}
