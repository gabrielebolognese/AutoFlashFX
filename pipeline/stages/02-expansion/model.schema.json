{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://instagramreels.local/stages/02-expansion/model-output",
  "title": "02-expansion: the model's structured answer (BUILD_SPEC.md S2); expansion.py compose checks it and writes expansion.md and expansion.json",
  "type": "object",
  "required": ["problem", "solution", "share_identity", "takeaway", "keyword", "deliverable", "deliverable_status", "one_true_thing", "evidence"],
  "properties": {
    "problem": {"type": "string"},
    "solution": {"type": "string"},
    "share_identity": {"type": "string"},
    "takeaway": {"type": "string"},
    "keyword": {"type": "string"},
    "deliverable": {"type": "string"},
    "deliverable_status": {"type": "string", "enum": ["existing", "new"]},
    "one_true_thing": {"type": "string"},
    "evidence": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["fact", "note"],
        "properties": {
          "fact": {"type": "integer"},
          "note": {"type": "string"}
        }
      }
    }
  }
}
