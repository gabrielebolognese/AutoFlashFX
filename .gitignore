# OS / editor
.DS_Store
Thumbs.db
desktop.ini
.vscode/
.idea/

# Python
__pycache__/
*.pyc
.venv/
venv/
.venv-tts/

# Node (HyperFrames, Puppeteer)
node_modules/
.harness/
channels/*/motion-lib/.harness/
channels/*/motion-lib/renders/
channels/*/golden/*/project/renders/
out/
dist/
.hyperframes/
.env
.env.*

# Runner state (BUILD_SPEC.md section 1 and 14.3): the channel folders, each its own. The shared exports/, logs/ and .locks/
# stay anchored to the root (pipeline/tests/fixtures/runs/ holds frozen test data)
/runs/
/exports/
/logs/
/.locks/
channels/*/runs/
channels/*/logs/
channels/*/.locks/
channels/*/.cache/
channels/*/stories/
channels/*/library/voice/*
!channels/*/library/voice/README.txt
channels/*/library/.hooks.index.json
channels/*/library/hooks.lint.txt
channels/*/library/character/photos/

# Reference videos, analysis frames, sound pack audio and caches
channels/*/styles/*/refs/
channels/*/styles/*/analysis/
channels/*/styles/sfx/**/*.wav
channels/*/styles/sfx/**/*.mp3
channels/*/styles/sfx/**/*.MP3
channels/*/styles/sfx/**/*.aif
channels/*/styles/sfx/**/*.aiff
channels/*/styles/sfx/**/*.ogg
channels/*/styles/sfx/**/*.flac
channels/*/styles/sfx/**/*.m4a
channels/*/styles/sfx/.cache/
channels/*/styles/sfx/previews/

# Large media: raw footage and renders
*.mp4
*.mov
*.m4a
*.wav

# Build runner runtime files
build/state.env
build/.status
build/status.txt
build/*.log
build/limits.log
build/*/batches/
build/check.*
build/PAUSE
voicetests/

# The golden reel: the render and the per-run reports are rebuilt by render-golden; the project's fonts and vendor
# files are copies of the channel's motion-lib/assets
channels/*/golden/*/golden.mp4
channels/*/golden/*/render.json
channels/*/golden/*/probe.json
channels/*/golden/*/check.json
channels/*/golden/*/project/assets/fonts/
channels/*/golden/*/project/assets/vendor/
channels/*/golden/*/project/assets/vo.wav
channels/*/golden/*/project/.hyperframes/
channels/*/golden/*/project/renders/
channels/*/golden/*/.sheet/
channels/*/motion-lib/.hyperframes/
